{{- /* Gallery URLs are meta-refresh redirects to /#film-<slug>; listing them makes Search Console report "Page with redirect". */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range where (where .Pages "Section" "ne" "gallery") "Sitemap.Disable" "ne" true }}
  <url><loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}<lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}</url>
{{- end }}
</urlset>
